# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/fingerprint_sync

# Dashboard/API port
APP_PORT=3001

# Manual attendance mode: biometric device sync is disabled
DISABLE_DEVICE_LISTENER=true
DEVICE_MODE=manual
SYNC_INTERVAL_MS=60000

# Dashboard login (set real values only in .env; never commit passwords)
LOGIN_EMAIL=admin@example.com
LOGIN_PASSWORD=change-this-password
# Optional session lifetime; default is 12 hours
SESSION_TTL_MS=43200000
